      "mode": "scope.collection.type_field",
      "type_field": "type"
    },
    "mapping": {
      "default_mapping": { "enabled": false, "dynamic": false },
      "default_analyzer": "en",
      "default_datetime_parser": "dateTimeOptional",
      "default_field": "_all",
      "default_type": "_default",
      "index_dynamic": false,
      "store_dynamic": false,
      "type_field": "_type",
      "types": {
        "inventory.hotel": {
          "enabled": true,
          "dynamic": false,
          "properties": {
            "embedding": { "enabled": true, "dynamic": false, "fields": [
