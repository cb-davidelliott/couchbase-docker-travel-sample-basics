              { "name": "description", "type": "text", "analyzer": "en", "index": true, "store": true } ] },
            "city": { "enabled": true, "dynamic": false, "fields": [
              { "name": "city", "type": "text", "analyzer": "keyword", "index": true, "store": true, "docvalues": true } ] },
            "country": { "enabled": true, "dynamic": false, "fields": [
              { "name": "country", "type": "text", "analyzer": "keyword", "index": true, "store": true, "docvalues": true } ] },
            "pets_ok": { "enabled": true, "dynamic": false, "fields": [
              { "name": "pets_ok", "type": "boolean", "index": true, "store": true, "docvalues": true } ] },
            "free_breakfast": { "enabled": true, "dynamic": false, "fields": [
              { "name": "free_breakfast", "type": "boolean", "index": true, "store": true, "docvalues": true } ] }
          }
        }
      }
    },
    "store": { "indexType": "scorch", "segmentVersion": 16 }
  },
  "sourceParams": {}
}
