# ---------------------------------------------------------------------------
# Demo configuration. Everything in the stack reads from here.
# These are DEMO-ONLY credentials for a local container. Never reuse them.
# ---------------------------------------------------------------------------

# --- Versions (pinned) ------------------------------------------------------
COUCHBASE_IMAGE=couchbase:enterprise-8.0.3
PYTHON_VERSION=3.12
COUCHBASE_SDK_VERSION=4.6.4
FASTEMBED_VERSION=0.9.1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMS=384

# --- Cluster admin (used by init/embed only, never by the demos) ------------
CB_ADMIN_USER=Administrator
CB_ADMIN_PASSWORD=password123
CB_CLUSTER_NAME=travel-demo

# --- Scoped application user (used by the demos; NOT an admin) --------------
CB_USER=demo
CB_PASSWORD=Demo-Passw0rd!

# --- Data -------------------------------------------------------------------
CB_BUCKET=travel-sample

# --- Connection (inside the compose network) --------------------------------
CB_HOST=couchbase
CB_CONNSTR=couchbase://couchbase

# --- Memory quotas in MB (kv + index + search must fit in Docker's RAM) -----
# Total service quota ~2.5 GB, plus ~1 GB for the OS and the query service.
CB_KV_QUOTA_MB=1024
CB_INDEX_QUOTA_MB=768
CB_FTS_QUOTA_MB=768

# --- Host ports (change here if something else already uses them) ----------
CB_PORT_UI=8091
CB_PORT_QUERY=8093
CB_PORT_SEARCH=8094
CB_PORT_KV=11210
